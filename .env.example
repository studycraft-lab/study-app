# Server-only values from the Supabase project Connect/API Keys panels.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Parent sign-in and protected content import. Use a long, unique value.
PARENT_IMPORT_PASSPHRASE=your-parent-passphrase

# Optional. Set independent long random values to rotate session signing separately.
# PARENT_SESSION_SECRET=your-parent-session-secret
# CHILD_SESSION_SECRET=your-child-session-secret

# Server-only AI grading. Never prefix the key with NEXT_PUBLIC_.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_ATTEMPTS=2

# Optional. Used as the OpenRouter HTTP Referer when configured.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Experimental tutoring remains disabled until the integrated pilot is accepted.
TUTOR_ENABLED=false

# Server-only OpenAI Realtime; keep off until the preview/device pilot is accepted.
TUTOR_LIVE_ENABLED=false
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
TUTOR_SESSION_SECONDS=600
TUTOR_DAILY_SECONDS=1200
# A supervised, continuously running Node controller is required. See docs/tutor/VOICE.md.
TUTOR_CONTROLLER_URL=http://127.0.0.1:4310
TUTOR_CONTROLLER_SECRET=
TUTOR_CONTROLLER_VERIFIED=false
# Controller process only; default binding is local. Use private networking or authenticated TLS.
TUTOR_CONTROLLER_HOST=127.0.0.1
TUTOR_CONTROLLER_PORT=4310
