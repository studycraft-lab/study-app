  "facts": [
    {
      "id": "introduction-fact",
      "text": "Plastids are dense bodies with two membranes in plant-cell cytoplasm. Animal cells have no plastids. There are three types: chloroplasts, chromoplasts and leucoplasts.",
      "citationIds": [
        "plastids-page"
      ]
    },
    {
      "id": "chloroplasts-fact",
      "text": "Chloroplasts look green because they contain chlorophyll, a green pigment. Chlorophyll helps capture sunlight during photosynthesis.",
      "citationIds": [
        "plastids-page"
      ]
    },
    {
      "id": "chromoplasts-fact",
      "text": "Chromoplast pigments are colours other than green, including red, yellow and orange. They give flowers and fruits their colour.",
      "citationIds": [
        "plastids-page"
      ]
    },
    {
      "id": "leucoplasts-fact",
      "text": "Leucoplasts have no pigment. They store starch, proteins and oils and occur mostly in seeds.",
      "citationIds": [
        "plastids-page"
      ]
    },
    {
      "id": "cytoplasm-fact",
      "text": "Cytoplasm is the jelly-like material inside a cell, between its membrane and nucleus.",
      "citationIds": [
        "cytoplasm-page"
      ]
    }
  ],
