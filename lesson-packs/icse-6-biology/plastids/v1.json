  "goals": [
    "Locate plastids in plant cells and name their three types.",
    "Connect chloroplasts with chlorophyll and sunlight.",
    "Distinguish coloured chromoplasts from colourless storage leucoplasts."
  ],
  "citations": [
    {
      "id": "plastids-page",
      "printedPage": "38",
