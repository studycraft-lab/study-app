    "chapter:review": "node .agents/skills/chapter-ingestion/scripts/chapter-ingestion.mjs review-bank",
    "chapter:normalize": "node .agents/skills/chapter-ingestion/scripts/chapter-ingestion.mjs normalize-bank",
    "chapter:import": "node .agents/skills/chapter-ingestion/scripts/chapter-ingestion.mjs import-bank"
