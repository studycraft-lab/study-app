{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://studycraft.local/schemas/chapter-manifest.schema.json",
  "title": "StudyCraft chapter source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "chapter", "sourcePolicy", "assets", "learningOutcomes"],
  "properties": {
    "manifestVersion": { "const": "0.1.0" },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "board", "grade", "subject", "bookTitle", "chapterNumber", "title"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "board": { "$ref": "#/definitions/nonEmptyString" },
        "grade": { "type": "integer", "minimum": 1 },
        "subject": { "$ref": "#/definitions/nonEmptyString" },
        "bookTitle": { "$ref": "#/definitions/nonEmptyString" },
        "chapterNumber": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originals", "repositoryCopies", "applicationStorage", "runtimeStrategy"],
      "properties": {
        "originals": { "enum": ["local-only", "private-storage"] },
        "repositoryCopies": { "const": false },
        "applicationStorage": { "enum": ["not-uploaded", "private"] },
        "runtimeStrategy": { "enum": ["none", "required-regions", "full-pages"] },
        "notes": { "type": "string" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fileName", "sha256", "width", "height", "pages"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "fileName": { "$ref": "#/definitions/nonEmptyString" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "pageNumber", "bounds"],
              "properties": {
                "id": { "$ref": "#/definitions/id" },
                "pageNumber": { "type": "integer", "minimum": 1 },
                "bounds": { "$ref": "#/definitions/bounds" }
              }
            }
          }
        }
      }
    },
    "learningOutcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/nonEmptyString" }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    }
  }
}
