{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://studycraft.local/schemas/question-bank.schema.json",
  "title": "StudyCraft question bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bank", "sources", "topics", "questions"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "board", "subject", "grade", "bookTitle", "chapterNumber", "status"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/definitions/nonEmptyString" },
        "board": { "$ref": "#/definitions/nonEmptyString" },
        "subject": { "$ref": "#/definitions/nonEmptyString" },
        "grade": { "type": "integer", "minimum": 1 },
        "bookTitle": { "$ref": "#/definitions/nonEmptyString" },
        "chapterNumber": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["draft", "reviewed", "published", "archived"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/source" }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "title": { "$ref": "#/definitions/nonEmptyString" },
          "learningOutcomeIds": {
            "type": "array",
            "items": { "$ref": "#/definitions/id" },
            "uniqueItems": true
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/question" }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pageNumber", "assetRef", "extractionConfidence", "reviewRequired", "regions"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "pageNumber": { "type": "integer", "minimum": 1 },
        "assetRef": { "$ref": "#/definitions/nonEmptyString" },
        "extractionConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewRequired": { "type": "boolean" },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "bounds"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "kind": { "enum": ["map", "diagram", "illustration", "timeline", "passage", "table", "exercise"] },
              "bounds": { "$ref": "#/definitions/bounds" },
              "runtimeAssetRef": { "$ref": "#/definitions/nonEmptyString" }
            }
          }
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageId", "supports"],
      "properties": {
        "pageId": { "$ref": "#/definitions/id" },
        "regionId": { "type": ["string", "null"] },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["prompt", "answer", "rubric", "hint", "explanation"] }
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["concept", "weight"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "concept": { "$ref": "#/definitions/nonEmptyString" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "required": { "type": "boolean" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "text": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "generatedAt", "validationStatus"],
      "properties": {
        "method": { "enum": ["codex-assisted", "parent-authored", "imported"] },
        "generatedAt": { "type": "string", "format": "date-time" },
        "validationStatus": { "enum": ["pending", "verified", "interaction-pending", "rejected"] }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "type", "status", "topicIds", "difficulty", "marks", "prompt", "sourceRefs", "response", "answer", "rubric", "hint", "explanation", "generation"],
      "properties": {
        "id": { "type": "string", "pattern": "^q-[0-9]{3}$" },
        "version": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["single_choice", "multiple_select", "fill_blank", "true_false_correct", "matching", "one_word", "brief_answer", "multi_point", "compare", "source_group", "map_work"] },
        "status": { "enum": ["active", "disabled", "review"] },
        "origin": { "enum": ["end_exercise", "chapter_content", "learning_outcome"] },
        "selectionPriority": { "type": "integer", "minimum": 1, "maximum": 3 },
        "topicIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
        "marks": { "type": "number", "exclusiveMinimum": 0 },
        "prompt": { "$ref": "#/definitions/nonEmptyString" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/sourceRef" } },
        "response": { "type": "object" },
        "answer": { "type": "object" },
        "rubric": { "type": "object" },
        "hint": { "$ref": "#/definitions/nonEmptyString" },
        "explanation": { "$ref": "#/definitions/nonEmptyString" },
        "generation": { "$ref": "#/definitions/generation" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "single_choice" } } },
          "then": {
            "properties": {
              "response": { "required": ["options"], "properties": { "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/option" } } } },
              "answer": { "required": ["correctOptionId"], "properties": { "correctOptionId": { "$ref": "#/definitions/id" } } },
              "rubric": { "required": ["exact"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "multiple_select" } } },
          "then": {
            "properties": {
              "response": { "required": ["options"], "properties": { "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/option" } } } },
              "answer": { "required": ["correctOptionIds"], "properties": { "correctOptionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } } } },
              "rubric": { "required": ["partialCredit"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["fill_blank", "one_word"] } } },
          "then": {
            "properties": {
              "answer": { "required": ["accepted"], "properties": { "accepted": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/nonEmptyString" } } } },
              "rubric": { "required": ["exact"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "true_false_correct" } } },
          "then": {
            "properties": {
              "response": { "required": ["requiresCorrectionWhenFalse"] },
              "answer": { "required": ["value"], "properties": { "value": { "type": "boolean" } } },
              "rubric": { "required": ["points"], "properties": { "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/point" } } } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "matching" } } },
          "then": {
            "properties": {
              "response": { "required": ["left", "right"] },
              "answer": { "required": ["pairs"] },
              "rubric": { "required": ["pointsPerPair"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["brief_answer", "multi_point", "compare", "map_work"] } } },
          "then": { "properties": { "rubric": { "required": ["points"], "properties": { "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/point" } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "source_group" } } },
          "then": {
            "properties": {
              "response": { "required": ["subquestions"] },
              "answer": { "required": ["subanswers"] },
              "rubric": { "required": ["subrubrics"] }
            }
          }
        }
      ]
    }
  }
}
