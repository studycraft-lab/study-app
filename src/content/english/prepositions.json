  "title": "Prepositions",
  "batchSize": 5,
  "introduction": "Learn the relationship a preposition shows, then answer five at a time.",
  "rules": [
    {
      "title": "Time: at, on, in, since, for",
      "body": "Use at for a clock time, on for a day or date, and in for a month or year. Since gives a starting point; for gives a duration.",
      "example": "at 8 o’clock · on Monday · in July · since 2020 · for an hour"
    },
    {
      "title": "Place: in, on, between, among",
      "body": "In means inside; on means touching a surface. Between links distinct people or things; among places something in a group.",
      "example": "in the box · on the table · between two windows · among the children"
    },
    {
      "title": "Movement: across, through, over",
      "body": "Across goes from one side to another. Through goes in and out of an enclosed space. Over goes above, and can also mean crossing a barrier.",
      "example": "across the road · through the tunnel · over the wall"
    },
    {
      "title": "Useful pairs and fixed phrases",
      "body": "By can name the doer; with can name the tool. Beside means next to; besides means in addition to. Learn patterns such as interested in and good at.",
      "example": "written by the poet · cut with scissors · interested in music"
    }
  ],
